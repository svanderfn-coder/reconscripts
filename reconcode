-- Returns the VehicleSeat the local player is currently sitting in, or nil
local function getOccupiedSeat()
    local character = player.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end

    -- Walk every VehicleSeat in the world
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("VehicleSeat") and obj.Occupant == humanoid then
            return obj
        end
    end
    return nil
end

-- Returns the root/primary part of whatever model the seat belongs to
local function getVehicleRoot(seat)
    if not seat then return nil end
    local model = seat:FindFirstAncestorOfClass("Model")
    if not model then return seat end
    return model.PrimaryPart or model:FindFirstChild("Body")
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChildWhichIsA("BasePart")
end

--// ─────────────────────────────────────────
--// Anchor
--// ─────────────────────────────────────────
local function setAnchored(state)
    anchored = state
    local character = player.Character
    if not character then return end
    local root = character:FindFirstChild("HumanoidRootPart")
    if root then root.Anchored = state end
end

player.CharacterAdded:Connect(function(character)
    local root = character:WaitForChild("HumanoidRootPart")
    root.Anchored = anchored
end)

--// ─────────────────────────────────────────
--// Auto Wheelie  (Kukirin-aware)
--// ─────────────────────────────────────────
--[[
    The Kukirin scooter in "Drive a Kukirin" has a model hierarchy like:
        Kukirin (Model)
         ├─ Body          ← primary / root part
         ├─ FrontWheel
         ├─ BackWheel
         └─ VehicleSeat  (or a Seat)

    To do a wheelie we:
      1. Find the seat the player is in.
      2. Grab the vehicle's Body (root) part.
      3. Every Heartbeat, rotate that part backward (~-40°) so the
         front lifts.  We only nudge it each frame so it fights gravity
         continuously and looks like a real wheelie rather than a
         one-shot snap.
--]]

local wheelieConn
local WHEELIE_ANGLE = math.rad(42)  -- how far to tilt back (degrees → radians)

local function startWheelie()
    if wheelieConn then wheelieConn:Disconnect() end
    wheelieConn = RunService.Heartbeat:Connect(function(dt)
        local seat = getOccupiedSeat()
        if not seat then return end

        local root = getVehicleRoot(seat)
        if not root or root.Anchored then return end

        -- Build a target CFrame that keeps the same world position and Y-yaw
        -- but pitches backward for the wheelie.
        local pos   = root.CFrame.Position
        local lookAt = root.CFrame.LookVector
        -- Flatten lookAt onto the XZ plane so we only yaw, never roll
        local flatLook = Vector3.new(lookAt.X, 0, lookAt.Z).Unit
        if flatLook ~= flatLook then return end  -- NaN guard

        local targetCF = CFrame.new(pos, pos + flatLook)
            * CFrame.Angles(-WHEELIE_ANGLE, 0, 0)

        -- Lerp toward the target so it eases in smoothly
        root.CFrame = root.CFrame:Lerp(targetCF, math.min(dt * 14, 1))

        -- Kill vertical velocity so it doesn't launch into the air
        local vel = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(vel.X, math.max(vel.Y, 0), vel.Z)
    end)
end

local function stopWheelie()
    if wheelieConn then wheelieConn:Disconnect(); wheelieConn = nil end
end

