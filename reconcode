local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

--// Settings
local autoWheelie = false

--// Auto Wheelie
local function getVehicleSeat()
	local character = player.Character
	if not character then return nil end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return nil end

	local seat = humanoid.SeatPart

	if seat and seat:IsA("VehicleSeat") then
		return seat
	end

	return nil
end

RunService.Heartbeat:Connect(function()
	if not autoWheelie then
		return
	end

	local seat = getVehicleSeat()
	if not seat then
		return
	end

	-- Apply a small backward rotation to create the wheelie effect
	local vehicle = seat:FindFirstAncestorOfClass("Model")
	if not vehicle then
		return
	end

	local root = vehicle.PrimaryPart or seat

	if root and root:IsA("BasePart") then
		root.AssemblyAngularVelocity = Vector3.new(
			-3,
			root.AssemblyAngularVelocity.Y,
			root.AssemblyAngularVelocity.Z
		)
	end
end)

--// Character
